<section class="image-with-text{% if section.settings.reverse %} image-with-text--reverse{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">

  <div class="image-with-text__media">
    {%- if section.settings.image != blank -%}
      <img
        class="image-with-text__image"
        src="{{ section.settings.image | img_url: '1200x' }}"
        srcset="{{ section.settings.image | img_url: '600x' }} 600w,
                {{ section.settings.image | img_url: '900x' }} 900w,
                {{ section.settings.image | img_url: '1200x' }} 1200w"
        sizes="(max-width: 767px) 100vw, 50vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}">
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'image-with-text__image' }}
    {%- endif -%}
  </div>

  <div class="image-with-text__content" style="background: {{ section.settings.bg_color }};">
    {%- if section.settings.eyebrow != blank -%}
      <p class="image-with-text__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="image-with-text__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="image-with-text__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--{{ section.settings.button_style }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse layout (text on left)",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Content background color",
      "default": "#ECEAE4"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the Mat"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Every piece in our collection is designed with the demands of training in mind — durable fabrics, thoughtful construction, and a fit that moves with you.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Solid dark" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
