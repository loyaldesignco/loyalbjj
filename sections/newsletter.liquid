<section class="newsletter-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="section-title" style="color: var(--color-surface);">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}
      <p style="color:rgba(255,255,255,0.6); font-size: var(--text-sm); margin-top: var(--sp-3);">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form">
        <input
          class="form-input"
          type="email"
          name="contact[email]"
          id="NewsletterEmail"
          value="{{ customer.email }}"
          placeholder="{{ section.settings.placeholder }}"
          autocorrect="off"
          autocapitalize="off"
          required>
        <button type="submit" class="btn btn--primary">
          {{ section.settings.button_label }}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter-success" style="color: rgba(255,255,255,0.7); margin-top: 1rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;">
          Thank you for subscribing.
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Join the Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the Loop"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "New drops, training tips, and members-only offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 120, "step": 8, "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 120, "step": 8, "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
