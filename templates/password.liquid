{%- form 'storefront_password', id: 'PasswordForm' -%}
  <h1 style="font-family: var(--font-heading); font-size: var(--text-3xl); font-weight: 300; margin-bottom: var(--sp-3);">Coming Soon</h1>
  <p style="font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--sp-8);">We're putting the finishing touches on something great.</p>

  {%- if form.error -%}
    <p style="color: var(--color-error); font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: var(--sp-3);">
      Incorrect password.
    </p>
  {%- endif -%}

  <div class="form-field">
    <input
      type="password"
      name="password"
      class="form-input"
      id="Password"
      placeholder="Password"
      autofocus
      autocomplete="current-password">
  </div>

  <button type="submit" class="btn btn--primary btn--full">Enter</button>

  {%- if shop.password_message != blank -%}
    <p style="margin-top: var(--sp-6); font-size: var(--text-sm); color: var(--color-text-muted);">{{ shop.password_message }}</p>
  {%- endif -%}
{%- endform -%}
